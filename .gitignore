.DS_Store

# Local-only documentation
local-docs/

# TypeScript workspace
node_modules/
apps/web/node_modules/
apps/web/.next/
apps/web/out/
apps/web/.env*
!apps/web/.env.example
*.tsbuildinfo

# Python services
services/*/.env*
!services/*/.env.example
services/*/.venv/
services/**/__pycache__/
services/**/.pytest_cache/
services/**/.ruff_cache/
*.py[cod]

# Local tooling
.idea/
.vscode/

# Local Python package builds
services/**/build/
services/**/*.egg-info/

# Terraform state, credentials and local execution artifacts
**/.terraform/
**/.terraform-tools/
**/*.tfstate*
**/*.tfplan
**/tfplan
**/plan.json
**/plan.txt
**/crash.log
**/crash.*.log
**/*.tfvars
**/*.tfvars.json
!**/*.tfvars.example
infra/gcp/terraform/bootstrap/backend.tf
