.DS_Store

# Local-only documentation
local-docs/

# TypeScript workspace
node_modules/
apps/web/node_modules/
apps/web/.next/
apps/web/out/
apps/web/.env*
!apps/web/.env.example
*.tsbuildinfo

# Python services
services/*/.env*
!services/*/.env.example
services/*/.venv/
services/**/__pycache__/
services/**/.pytest_cache/
services/**/.ruff_cache/
*.py[cod]

# Local tooling
.idea/
.vscode/

# Local Python package builds
services/**/build/
services/**/*.egg-info/

# Terraform state, credentials and local execution artifacts
**/.terraform/
**/.terraform-tools/
**/*.tfstate*
**/*.tfplan
**/tfplan
**/plan.json
**/plan.txt
**/crash.log
**/crash.*.log
**/*.tfvars
**/*.tfvars.json
!**/*.tfvars.example
infra/gcp/terraform/bootstrap/backend.tf

# Local deployment instances and credentials are never source/build inputs.
.env
.env.*
**/.env
**/.env.*
!.env.example
!.env.template
!**/.env.example
!**/.env.template
**/credentials.json
**/service-account.json
**/service_account.json
**/*-service-account.json
**/*-credentials.json
**/application_default_credentials.json
**/*.pem
**/*.key
**/*.p12
**/*.pfx
!**/*.public.pem
!**/*.example.pem
**/id_rsa
**/id_ed25519
**/deployment-profile.local.json
**/*.deployment-profile.local.json
**/deployments/local
**/.deployment
.security-tools
