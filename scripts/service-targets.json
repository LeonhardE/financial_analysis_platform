{
  "schema_version": 1,
  "targets": [
    {
      "id": "agent-hub-service",
      "kind": "backend",
      "directory": "services/agent-hub-service",
      "service": "agent-hub-api",
      "cloudbuild": "infra/gcp/cloudbuild.agent-hub.yaml",
      "release_mode": "build_only"
    },
    {
      "id": "market-data-service",
      "kind": "backend",
      "directory": "services/market-data-service",
      "service": "market-api",
      "cloudbuild": "infra/gcp/cloudbuild.api.yaml",
      "release_mode": "existing"
    },
    {
      "id": "user-service",
      "kind": "backend",
      "directory": "services/user-service",
      "service": "user-api",
      "cloudbuild": "infra/gcp/cloudbuild.user.yaml",
      "release_mode": "existing"
    },
    {
      "id": "config-service",
      "kind": "backend",
      "directory": "services/config-service",
      "service": "config-api",
      "cloudbuild": "infra/gcp/cloudbuild.config.yaml",
      "release_mode": "existing"
    },
    {
      "id": "web",
      "kind": "web",
      "directory": "apps/web",
      "service": "market-web",
      "cloudbuild": "infra/gcp/cloudbuild.web.yaml",
      "release_mode": "existing"
    },
    {
      "id": "portfolio-service",
      "kind": "backend",
      "directory": "services/portfolio-service",
      "service": "portfolio-api",
      "cloudbuild": "infra/gcp/cloudbuild.portfolio.yaml",
      "release_mode": "build_only"
    }
  ]
}
