# Set your Firebase project ID explicitly to enable verified local sign-in.
FIREBASE_PROJECT_ID=
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
MARKET_API_BASE_URL=http://127.0.0.1:8000
USER_STORE_BACKEND=sqlite
WATCHLIST_DB_PATH=/tmp/financial-analysis/watchlists.sqlite3
FIRESTORE_DATABASE=(default)

# Optional local override; otherwise shares WATCHLIST_DB_PATH with separate tables.
# CHANNEL_FOLLOWS_DB_PATH=/tmp/financial-analysis/user.sqlite3

# Internal v2 metadata is closed until INF-007 supplies all four trusted settings.
USER_SERVICE_AUDIENCE=
USER_DELEGATION_AUDIENCE=
USER_DELEGATION_ISSUER=
USER_TRUSTED_HUB_CALLERS=
