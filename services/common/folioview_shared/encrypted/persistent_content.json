        "rootKeyId",
        "agentSigningKeyId",
        "agentEncryptionKeyId",
        "identityEpoch",
        "bindingFingerprint",
        "audience",
        "method",
        "path",
        "bodyDigest",
        "requestId",
        "nonce",
        "issuedAt",
        "expiresAt"
      ],
      "additionalProperties": false
    },
