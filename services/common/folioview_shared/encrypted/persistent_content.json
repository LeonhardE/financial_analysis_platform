{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://folioview.example/contracts/persistent-content.v1",
  "$defs": {
    "PersistentContentRecipient": {
      "type": "object",
      "properties": {
        "keyId": {
          "$ref": "#/$defs/KeyId"
        },
        "role": {
          "enum": ["agent_enc", "device_enc", "recovery_enc"]
        }
      },
      "required": ["keyId", "role"],
      "additionalProperties": false
    },
    "PersistentTaskContext": {
      "type": "object",
      "properties": {
        "contractVersion": {
          "const": "folioview.agent-workspace.v2.0"
        },
        "profile": {
          "const": "folioview.persistent-content.v1"
        },
        "ownerSubject": {
          "$ref": "#/$defs/Identifier"
        },
        "vaultId": {
          "$ref": "#/$defs/Identifier"
        },
        "connectionId": {
          "$ref": "#/$defs/Identifier"
        },
        "agentId": {
          "$ref": "#/$defs/Identifier"
        },
        "clientId": {
          "$ref": "#/$defs/Identifier"
        },
        "rootKeyId": {
          "$ref": "#/$defs/KeyId"
        },
        "agentSigningKeyId": {
          "$ref": "#/$defs/KeyId"
        },
        "agentEncryptionKeyId": {
          "$ref": "#/$defs/KeyId"
        },
        "identityEpoch": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "bindingFingerprint": {
          "$ref": "#/$defs/Digest"
        },
        "registrySequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "checkpointDigest": {
          "$ref": "#/$defs/Digest"
        },
        "keyEpoch": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "stableOperationId": {
          "$ref": "#/$defs/OperationIdentifier"
        },
        "issuedAt": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "objectId": {
          "$ref": "#/$defs/Identifier"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "expectedRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "recipients": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PersistentContentRecipient"
          },
          "minItems": 1,
          "maxItems": 8
        },
        "objectType": {
          "const": "task"
        },
        "purpose": {
          "const": "execute_task"
        },
        "resultPolicy": {
          "enum": ["none", "owner_inbox"]
        },
        "taskId": {
          "$ref": "#/$defs/Identifier"
        },
        "taskVersion": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "executionEpoch": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "authorityId": {
          "$ref": "#/$defs/Identifier"
        },
        "authorityVersion": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "expectedAuthorityVersion": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "expectedAuthorityDigest": {
          "anyOf": [
            {
              "$ref": "#/$defs/Digest"
            },
            {
              "type": "null"
            }
          ]
        },
        "ownerTaskFingerprint": {
          "$ref": "#/$defs/Digest"
        },
        "resourceBindings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ResourceBindingMetadata"
          },
          "minItems": 1,
          "maxItems": 10
        }
      },
      "required": [
        "contractVersion",
        "profile",
        "ownerSubject",
        "vaultId",
        "connectionId",
        "agentId",
        "clientId",
        "rootKeyId",
        "agentSigningKeyId",
        "agentEncryptionKeyId",
        "identityEpoch",
        "bindingFingerprint",
        "registrySequence",
        "checkpointDigest",
        "keyEpoch",
        "stableOperationId",
        "issuedAt",
        "objectId",
        "revision",
        "expectedRevision",
        "recipients",
        "objectType",
        "purpose",
        "resultPolicy",
        "taskId",
        "taskVersion",
        "executionEpoch",
        "authorityId",
        "authorityVersion",
        "expectedAuthorityVersion",
        "expectedAuthorityDigest",
        "ownerTaskFingerprint",
        "resourceBindings"
      ],
      "additionalProperties": false
    },
    "PersistentResourceContext": {
      "type": "object",
      "properties": {
        "contractVersion": {
          "const": "folioview.agent-workspace.v2.0"
