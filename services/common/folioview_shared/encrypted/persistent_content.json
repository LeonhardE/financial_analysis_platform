    "PersistentContentContext": {
      "oneOf": [
        {
          "$ref": "#/$defs/PersistentTaskContext"
        },
        {
          "$ref": "#/$defs/PersistentResourceContext"
        },
        {
          "$ref": "#/$defs/PersistentResultContext"
        }
      ]
    },
    "PersistentContentProofPayload": {
      "type": "object",
      "properties": {
        "contractVersion": {
          "const": "folioview.agent-workspace.v2.0"
        },
        "profile": {
          "const": "folioview.persistent-content.v1"
        },
        "artifactType": {
          "const": "persistent_content_publication"
        },
        "context": {
          "$ref": "#/$defs/PersistentContentContext"
        },
        "ciphertextDigest": {
          "$ref": "#/$defs/Digest"
        }
      },
      "required": ["contractVersion", "profile", "artifactType", "context", "ciphertextDigest"],
      "additionalProperties": false
    },
    "PersistentContentCarrier": {
      "type": "object",
      "properties": {
        "contractVersion": {
          "const": "folioview.agent-workspace.v2.0"
        },
        "profile": {
          "const": "folioview.persistent-content.v1"
        },
        "proof": {
          "$ref": "#/$defs/SignedObject"
        },
        "jwe": {
          "$ref": "#/$defs/JWE"
        }
      },
      "required": ["contractVersion", "profile", "proof", "jwe"],
      "additionalProperties": false
    },
    "PersistentPrivatePayload": {
      "type": "object",
      "properties": {
        "privateSchemaVersion": {
          "const": 1
        },
        "profile": {
          "const": "folioview.persistent-content.v1"
        },
        "objectId": {
          "$ref": "#/$defs/Identifier"
        },
        "objectType": {
          "enum": [
            "task",
            "holdings_snapshot",
            "watchlist_evidence",
            "channel_follows_evidence",
            "result_revision"
          ]
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "payload": {
          "type": "object"
        }
      },
      "required": [
        "privateSchemaVersion",
        "profile",
        "objectId",
        "objectType",
        "revision",
        "payload"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "objectType": {
                "const": "task"
              }
            }
          },
          "then": {
            "properties": {
              "payload": {
                "$ref": "#/$defs/TaskContent"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "objectType": {
                "const": "result_revision"
              }
            }
          },
          "then": {
            "properties": {
              "payload": {
                "$ref": "#/$defs/ResultContent"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "objectType": {
                "const": "holdings_snapshot"
              }
            }
          },
          "then": {
            "properties": {
              "payload": {
                "$ref": "#/$defs/ResourceContent"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "objectType": {
                "const": "watchlist_evidence"
              }
            }
          },
          "then": {
            "properties": {
              "payload": {
                "$ref": "#/$defs/ResourceContent"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "objectType": {
                "const": "channel_follows_evidence"
              }
            }
          },
          "then": {
            "properties": {
              "payload": {
                "$ref": "#/$defs/ResourceContent"
              }
            }
          }
        }
      ]
    },
    "PersistentAgentRequestPayload": {
      "type": "object",
      "properties": {
        "contractVersion": {
          "const": "folioview.agent-workspace.v2.0"
        },
        "profile": {
          "const": "folioview.persistent-content.v1"
