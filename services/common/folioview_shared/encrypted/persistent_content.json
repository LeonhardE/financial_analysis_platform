        "identityEpoch": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "bindingFingerprint": {
          "$ref": "#/$defs/Digest"
        },
        "audience": {
          "type": "string",
          "format": "uri",
          "maxLength": 2048
        },
        "method": {
          "enum": ["GET", "POST"]
        },
        "path": {
          "type": "string",
          "pattern": "^/agent/v3/persistent/[A-Za-z0-9/_-]+$",
          "maxLength": 768
        },
        "bodyDigest": {
          "$ref": "#/$defs/Digest"
        },
        "requestId": {
          "$ref": "#/$defs/OperationIdentifier"
        },
        "nonce": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$",
          "maxLength": 43
        },
        "issuedAt": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "expiresAt": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
