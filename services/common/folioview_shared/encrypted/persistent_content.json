        },
        "permissionId": {
          "$ref": "#/$defs/Identifier"
        },
        "permissionEpoch": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "ownerEnvelopeFingerprint": {
          "$ref": "#/$defs/Digest"
        }
      },
      "required": [
        "contractVersion",
        "profile",
        "ownerSubject",
        "vaultId",
        "connectionId",
