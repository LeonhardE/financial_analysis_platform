{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:folioview:persistent-resource-consent:v1",
  "title": "Persistent logical resource consent; closed opt-in public contracts",
  "$defs": {
    "ConsentResourceApproval": {
      "type": "object",
      "properties": {
        "permissionId": {
          "$ref": "#/$defs/Identifier"
        },
        "ref": {
          "$ref": "#/$defs/ResourceRef"
        },
        "sourceEpoch": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "fromRevision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "versionPolicy": {
          "const": "current_and_future"
        },
        "selectedHistory": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "minItems": 0,
          "maxItems": 50,
          "uniqueItems": true
        },
        "expectedPermissionEpoch": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "permissionId",
        "ref",
        "sourceEpoch",
        "fromRevision",
        "versionPolicy",
        "selectedHistory",
        "expectedPermissionEpoch"
      ],
      "additionalProperties": false
    },
    "ResourcePermission": {
      "type": "object",
      "properties": {
        "permissionId": {
          "$ref": "#/$defs/Identifier"
        },
        "ref": {
          "$ref": "#/$defs/ResourceRef"
        },
        "sourceEpoch": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "fromRevision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "versionPolicy": {
          "const": "current_and_future"
        },
        "selectedHistory": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "minItems": 0,
          "maxItems": 50,
          "uniqueItems": true
        },
        "permissionEpoch": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "status": {
          "enum": ["active", "revoked"]
        },
        "approvedAt": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "approvalFingerprint": {
          "$ref": "#/$defs/Digest"
        },
        "revokedAt": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "revocationFingerprint": {
          "anyOf": [
            {
              "$ref": "#/$defs/Digest"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "permissionId",
        "ref",
        "sourceEpoch",
        "fromRevision",
        "versionPolicy",
        "selectedHistory",
        "permissionEpoch",
        "status",
        "approvedAt",
        "approvalFingerprint",
        "revokedAt",
        "revocationFingerprint"
      ],
      "additionalProperties": false
    },
    "ResourcePermissionTarget": {
      "type": "object",
      "properties": {
        "permissionId": {
          "$ref": "#/$defs/Identifier"
        },
        "ref": {
          "$ref": "#/$defs/ResourceRef"
        },
        "expectedPermissionEpoch": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": ["permissionId", "ref", "expectedPermissionEpoch"],
      "additionalProperties": false
    },
    "ConsentSourceState": {
      "type": "object",
      "properties": {
        "ownerSubject": {
          "$ref": "#/$defs/Identifier"
        },
        "vaultId": {
          "$ref": "#/$defs/Identifier"
        },
        "ref": {
          "$ref": "#/$defs/ResourceRef"
        },
        "sourceEpoch": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "currentRevision": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "state": {
          "enum": ["active", "revoking", "disconnected", "deleted", "unavailable"]
        }
      },
      "required": ["ownerSubject", "vaultId", "ref", "sourceEpoch", "currentRevision", "state"],
      "additionalProperties": false
    },
    "PersistentResourceApprovalPayload": {
      "type": "object",
      "properties": {
        "contractVersion": {
          "const": "folioview.agent-workspace.v2.0"
        },
        "profile": {
          "const": "folioview.persistent-resource-consent.v1"
        },
        "ownerSubject": {
          "$ref": "#/$defs/Identifier"
        },
        "vaultId": {
          "$ref": "#/$defs/Identifier"
        },
        "connectionId": {
          "$ref": "#/$defs/Identifier"
        },
        "agentId": {
          "$ref": "#/$defs/Identifier"
        },
        "clientId": {
          "$ref": "#/$defs/Identifier"
        },
        "rootKeyId": {
          "$ref": "#/$defs/KeyId"
        },
        "agentSigningKeyId": {
          "$ref": "#/$defs/KeyId"
        },
        "agentEncryptionKeyId": {
          "$ref": "#/$defs/KeyId"
        },
        "identityEpoch": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "bindingFingerprint": {
          "$ref": "#/$defs/Digest"
        },
        "consentId": {
          "$ref": "#/$defs/Identifier"
        },
        "purpose": {
          "const": "analysis"
        },
        "stableOperationId": {
          "$ref": "#/$defs/OperationIdentifier"
        },
        "expectedVersion": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "expectedConsentDigest": {
          "anyOf": [
            {
              "$ref": "#/$defs/Digest"
            },
            {
              "type": "null"
            }
          ]
        },
        "issuedAt": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "registrySequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "checkpointDigest": {
          "$ref": "#/$defs/Digest"
        },
        "keyEpoch": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "artifactType": {
          "const": "persistent_resource_approval"
        },
        "resources": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "items": {
            "$ref": "#/$defs/ConsentResourceApproval"
          }
        },
        "authorKeyId": {
          "$ref": "#/$defs/KeyId"
        }
      },
      "required": [
        "contractVersion",
        "profile",
        "ownerSubject",
        "vaultId",
        "connectionId",
        "agentId",
        "clientId",
        "rootKeyId",
        "agentSigningKeyId",
        "agentEncryptionKeyId",
        "identityEpoch",
        "bindingFingerprint",
        "consentId",
        "purpose",
        "authorKeyId",
        "stableOperationId",
        "expectedVersion",
        "expectedConsentDigest",
        "issuedAt",
        "registrySequence",
        "checkpointDigest",
        "keyEpoch",
        "artifactType",
        "resources"
      ],
      "additionalProperties": false
    },
    "PersistentResourceRevocationPayload": {
      "type": "object",
      "properties": {
        "contractVersion": {
          "const": "folioview.agent-workspace.v2.0"
        },
        "profile": {
          "const": "folioview.persistent-resource-consent.v1"
        },
        "ownerSubject": {
          "$ref": "#/$defs/Identifier"
        },
        "vaultId": {
          "$ref": "#/$defs/Identifier"
        },
        "connectionId": {
          "$ref": "#/$defs/Identifier"
        },
        "agentId": {
          "$ref": "#/$defs/Identifier"
        },
        "clientId": {
          "$ref": "#/$defs/Identifier"
        },
        "rootKeyId": {
          "$ref": "#/$defs/KeyId"
        },
        "agentSigningKeyId": {
          "$ref": "#/$defs/KeyId"
        },
        "agentEncryptionKeyId": {
          "$ref": "#/$defs/KeyId"
        },
        "identityEpoch": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "bindingFingerprint": {
          "$ref": "#/$defs/Digest"
        },
        "consentId": {
          "$ref": "#/$defs/Identifier"
        },
        "purpose": {
          "const": "analysis"
        },
        "stableOperationId": {
          "$ref": "#/$defs/OperationIdentifier"
        },
        "expectedVersion": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "expectedConsentDigest": {
          "anyOf": [
            {
              "$ref": "#/$defs/Digest"
            },
            {
              "type": "null"
            }
          ]
        },
        "issuedAt": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "registrySequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "checkpointDigest": {
          "$ref": "#/$defs/Digest"
        },
        "keyEpoch": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "artifactType": {
          "const": "persistent_resource_revocation"
        },
        "targets": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "items": {
            "$ref": "#/$defs/ResourcePermissionTarget"
          }
        },
        "authorKeyId": {
          "$ref": "#/$defs/KeyId"
        }
      },
      "required": [
        "contractVersion",
        "profile",
        "ownerSubject",
        "vaultId",
        "connectionId",
        "agentId",
        "clientId",
        "rootKeyId",
        "agentSigningKeyId",
        "agentEncryptionKeyId",
        "identityEpoch",
        "bindingFingerprint",
        "consentId",
        "purpose",
        "authorKeyId",
        "stableOperationId",
        "expectedVersion",
        "expectedConsentDigest",
        "issuedAt",
        "registrySequence",
        "checkpointDigest",
        "keyEpoch",
        "artifactType",
        "targets"
      ],
      "additionalProperties": false
    },
    "PersistentResourceConsent": {
      "type": "object",
      "properties": {
        "contractVersion": {
          "const": "folioview.agent-workspace.v2.0"
        },
        "profile": {
          "const": "folioview.persistent-resource-consent.v1"
        },
        "ownerSubject": {
          "$ref": "#/$defs/Identifier"
        },
        "vaultId": {
          "$ref": "#/$defs/Identifier"
        },
        "connectionId": {
          "$ref": "#/$defs/Identifier"
        },
        "agentId": {
          "$ref": "#/$defs/Identifier"
        },
        "clientId": {
          "$ref": "#/$defs/Identifier"
        },
        "rootKeyId": {
          "$ref": "#/$defs/KeyId"
        },
        "agentSigningKeyId": {
          "$ref": "#/$defs/KeyId"
        },
        "agentEncryptionKeyId": {
          "$ref": "#/$defs/KeyId"
        },
        "identityEpoch": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "bindingFingerprint": {
          "$ref": "#/$defs/Digest"
        },
        "consentId": {
          "$ref": "#/$defs/Identifier"
        },
        "purpose": {
          "const": "analysis"
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "createdAt": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "updatedAt": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "lastOperationId": {
          "$ref": "#/$defs/OperationIdentifier"
        },
        "lastControlFingerprint": {
          "$ref": "#/$defs/Digest"
        },
        "permissions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/ResourcePermission"
          }
        }
      },
      "required": [
        "contractVersion",
        "profile",
        "ownerSubject",
        "vaultId",
        "connectionId",
        "agentId",
        "clientId",
        "rootKeyId",
        "agentSigningKeyId",
        "agentEncryptionKeyId",
        "identityEpoch",
        "bindingFingerprint",
        "consentId",
        "purpose",
        "version",
        "createdAt",
        "updatedAt",
        "lastOperationId",
        "lastControlFingerprint",
        "permissions"
      ],
      "additionalProperties": false
    }
  }
}
