{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:folioview:persistent-agent-identity:v1",
  "title": "Persistent Agent public identity and one-use session recovery; opt-in extension",
  "$defs": {
    "PersistentAgentBindingPayload": {
      "type": "object",
      "properties": {
        "contractVersion": {
          "const": "folioview.agent-workspace.v2.0"
        },
        "profile": {
          "const": "folioview.persistent-agent-identity.v1"
        },
        "artifactType": {
          "const": "persistent_agent_binding"
        },
        "ownerSubject": {
          "$ref": "#/$defs/Identifier"
        },
        "vaultId": {
          "$ref": "#/$defs/Identifier"
        },
        "connectionId": {
          "$ref": "#/$defs/Identifier"
        },
        "agentId": {
          "$ref": "#/$defs/Identifier"
        },
        "clientId": {
          "$ref": "#/$defs/Identifier"
        },
        "rootKeyId": {
          "$ref": "#/$defs/KeyId"
        },
        "agentSigningKeyId": {
          "$ref": "#/$defs/KeyId"
        },
        "agentEncryptionKeyId": {
          "$ref": "#/$defs/KeyId"
        },
        "identityEpoch": {
          "const": 1
        },
        "deviceSigningKeyId": {
          "$ref": "#/$defs/KeyId"
        },
        "stableOperationId": {
          "$ref": "#/$defs/OperationIdentifier"
        },
        "registrySequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "checkpointDigest": {
          "$ref": "#/$defs/Digest"
        },
        "keyEpoch": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "issuedAt": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "contractVersion",
        "profile",
        "artifactType",
        "ownerSubject",
        "vaultId",
        "connectionId",
        "agentId",
        "clientId",
        "rootKeyId",
        "agentSigningKeyId",
        "agentEncryptionKeyId",
        "identityEpoch",
        "deviceSigningKeyId",
        "stableOperationId",
        "registrySequence",
        "checkpointDigest",
        "keyEpoch",
        "issuedAt"
      ],
      "additionalProperties": false
    },
    "PersistentAgentIdentity": {
      "type": "object",
      "properties": {
        "contractVersion": {
          "const": "folioview.agent-workspace.v2.0"
        },
        "profile": {
          "const": "folioview.persistent-agent-identity.v1"
        },
        "ownerSubject": {
          "$ref": "#/$defs/Identifier"
        },
        "vaultId": {
          "$ref": "#/$defs/Identifier"
        },
        "connectionId": {
          "$ref": "#/$defs/Identifier"
        },
        "agentId": {
          "$ref": "#/$defs/Identifier"
        },
        "clientId": {
          "$ref": "#/$defs/Identifier"
        },
        "rootKeyId": {
          "$ref": "#/$defs/KeyId"
        },
        "agentSigningKeyId": {
          "$ref": "#/$defs/KeyId"
        },
        "agentEncryptionKeyId": {
          "$ref": "#/$defs/KeyId"
        },
        "identityEpoch": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "bindingFingerprint": {
          "$ref": "#/$defs/Digest"
        },
        "status": {
          "enum": ["active", "revoked"]
        },
        "registeredAt": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "revokedAt": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "contractVersion",
        "profile",
        "ownerSubject",
        "vaultId",
        "connectionId",
        "agentId",
        "clientId",
        "rootKeyId",
        "agentSigningKeyId",
        "agentEncryptionKeyId",
        "identityEpoch",
        "bindingFingerprint",
        "status",
        "registeredAt",
        "revokedAt"
      ],
      "additionalProperties": false
    },
    "PersistentAgentRevocationPayload": {
      "type": "object",
      "properties": {
        "contractVersion": {
          "const": "folioview.agent-workspace.v2.0"
        },
        "profile": {
          "const": "folioview.persistent-agent-identity.v1"
        },
        "artifactType": {
          "const": "persistent_agent_revoke"
        },
        "ownerSubject": {
          "$ref": "#/$defs/Identifier"
        },
        "vaultId": {
          "$ref": "#/$defs/Identifier"
        },
        "connectionId": {
          "$ref": "#/$defs/Identifier"
        },
        "agentId": {
          "$ref": "#/$defs/Identifier"
        },
        "clientId": {
          "$ref": "#/$defs/Identifier"
        },
        "rootKeyId": {
          "$ref": "#/$defs/KeyId"
        },
        "agentSigningKeyId": {
          "$ref": "#/$defs/KeyId"
        },
        "agentEncryptionKeyId": {
          "$ref": "#/$defs/KeyId"
        },
        "identityEpoch": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "bindingFingerprint": {
          "$ref": "#/$defs/Digest"
        },
        "deviceSigningKeyId": {
          "$ref": "#/$defs/KeyId"
        },
        "stableOperationId": {
          "$ref": "#/$defs/OperationIdentifier"
        },
        "registrySequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "checkpointDigest": {
          "$ref": "#/$defs/Digest"
        },
        "keyEpoch": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "issuedAt": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "contractVersion",
        "profile",
        "artifactType",
        "ownerSubject",
        "vaultId",
        "connectionId",
        "agentId",
        "clientId",
        "rootKeyId",
        "agentSigningKeyId",
        "agentEncryptionKeyId",
        "identityEpoch",
        "bindingFingerprint",
        "deviceSigningKeyId",
        "stableOperationId",
        "registrySequence",
        "checkpointDigest",
        "keyEpoch",
        "issuedAt"
      ],
      "additionalProperties": false
    },
    "AgentSessionChallenge": {
      "type": "object",
      "properties": {
        "contractVersion": {
          "const": "folioview.agent-workspace.v2.0"
        },
        "profile": {
          "const": "folioview.persistent-agent-identity.v1"
        },
        "purpose": {
          "const": "resume_session"
        },
        "ownerSubject": {
          "$ref": "#/$defs/Identifier"
        },
        "vaultId": {
          "$ref": "#/$defs/Identifier"
        },
        "connectionId": {
          "$ref": "#/$defs/Identifier"
        },
        "agentId": {
          "$ref": "#/$defs/Identifier"
        },
        "clientId": {
          "$ref": "#/$defs/Identifier"
        },
        "rootKeyId": {
          "$ref": "#/$defs/KeyId"
        },
        "agentSigningKeyId": {
          "$ref": "#/$defs/KeyId"
        },
        "agentEncryptionKeyId": {
          "$ref": "#/$defs/KeyId"
        },
        "identityEpoch": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "bindingFingerprint": {
          "$ref": "#/$defs/Digest"
        },
        "challengeId": {
          "$ref": "#/$defs/OperationIdentifier"
        },
        "audience": {
          "type": "string",
          "minLength": 9,
          "maxLength": 2048,
          "pattern": "^https://[^\\s]+$"
        },
        "nonce": {
          "$ref": "#/$defs/KeyId"
        },
        "issuedAt": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "expiresAt": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "contractVersion",
        "profile",
        "purpose",
        "ownerSubject",
        "vaultId",
        "connectionId",
        "agentId",
        "clientId",
        "rootKeyId",
        "agentSigningKeyId",
        "agentEncryptionKeyId",
        "identityEpoch",
        "bindingFingerprint",
        "challengeId",
        "audience",
        "nonce",
        "issuedAt",
        "expiresAt"
      ],
      "additionalProperties": false
    },
    "AgentSessionProofPayload": {
      "type": "object",
      "properties": {
        "contractVersion": {
          "const": "folioview.agent-workspace.v2.0"
        },
        "profile": {
          "const": "folioview.persistent-agent-identity.v1"
        },
        "purpose": {
          "const": "resume_session"
        },
        "ownerSubject": {
          "$ref": "#/$defs/Identifier"
        },
        "vaultId": {
          "$ref": "#/$defs/Identifier"
        },
        "connectionId": {
          "$ref": "#/$defs/Identifier"
        },
        "agentId": {
          "$ref": "#/$defs/Identifier"
        },
        "clientId": {
          "$ref": "#/$defs/Identifier"
        },
        "rootKeyId": {
          "$ref": "#/$defs/KeyId"
        },
        "agentSigningKeyId": {
          "$ref": "#/$defs/KeyId"
        },
        "agentEncryptionKeyId": {
          "$ref": "#/$defs/KeyId"
        },
        "identityEpoch": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "bindingFingerprint": {
          "$ref": "#/$defs/Digest"
        },
        "challengeId": {
          "$ref": "#/$defs/OperationIdentifier"
        },
        "audience": {
          "type": "string",
          "minLength": 9,
          "maxLength": 2048,
          "pattern": "^https://[^\\s]+$"
        },
        "nonce": {
          "$ref": "#/$defs/KeyId"
        },
        "issuedAt": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "expiresAt": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "artifactType": {
          "const": "persistent_agent_session_proof"
        }
      },
      "required": [
        "contractVersion",
        "profile",
        "purpose",
        "ownerSubject",
        "vaultId",
        "connectionId",
        "agentId",
        "clientId",
        "rootKeyId",
        "agentSigningKeyId",
        "agentEncryptionKeyId",
        "identityEpoch",
        "bindingFingerprint",
        "challengeId",
        "audience",
        "nonce",
        "issuedAt",
        "expiresAt",
        "artifactType"
      ],
      "additionalProperties": false
    }
  }
}
