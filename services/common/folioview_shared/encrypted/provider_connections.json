{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:folioview:provider-connection-slot:v1",
  "$defs": {
    "ProviderCredentialRef": {
      "type": "object",
      "properties": {
        "connectionId": {
          "$ref": "#/$defs/Identifier"
        },
        "clientId": {
          "$ref": "#/$defs/Identifier"
        },
        "credentialGeneration": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "credentialFingerprint": {
          "$ref": "#/$defs/Digest"
        }
      },
      "required": ["connectionId", "clientId", "credentialGeneration", "credentialFingerprint"],
      "additionalProperties": false
    },
    "ProviderConnectionSlot": {
      "type": "object",
      "properties": {
        "contractVersion": {
          "const": "folioview.agent-workspace.v2.0"
        },
        "profile": {
          "const": "folioview.provider-connection-slot.v1"
        },
        "ownerSubject": {
          "$ref": "#/$defs/Identifier"
        },
        "vaultId": {
          "$ref": "#/$defs/Identifier"
        },
        "provider": {
          "enum": ["muse", "chatgpt"]
        },
        "slotId": {
          "$ref": "#/$defs/Identifier"
        },
        "slotVersion": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "slotGeneration": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "currentCredential": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProviderCredentialRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "lastCredential": {
          "$ref": "#/$defs/ProviderCredentialRef"
        }
      },
      "required": [
        "contractVersion",
        "profile",
        "ownerSubject",
        "vaultId",
        "provider",
        "slotId",
        "slotVersion",
        "slotGeneration",
        "currentCredential",
        "lastCredential"
      ],
      "additionalProperties": false
    },
    "ProviderTaskSelection": {
      "type": "object",
      "properties": {
        "taskId": {
          "$ref": "#/$defs/Identifier"
        },
        "taskVersion": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "executionEpoch": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "grantFingerprint": {
          "$ref": "#/$defs/Digest"
        },
        "resourceIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Identifier"
          },
          "maxItems": 10,
          "uniqueItems": true
        }
      },
      "required": ["taskId", "taskVersion", "executionEpoch", "grantFingerprint", "resourceIds"],
      "additionalProperties": false
    },
    "ProviderConnectionReview": {
      "type": "object",
      "properties": {
        "contractVersion": {
          "const": "folioview.agent-workspace.v2.0"
        },
        "profile": {
          "const": "folioview.provider-connection-slot.v1"
        },
        "ownerSubject": {
          "$ref": "#/$defs/Identifier"
        },
        "vaultId": {
          "$ref": "#/$defs/Identifier"
        },
        "provider": {
          "enum": ["muse", "chatgpt"]
        },
        "slotId": {
          "$ref": "#/$defs/Identifier"
        },
        "retiredCredentials": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ProviderCredentialRef"
          },
          "maxItems": 32,
          "uniqueItems": true
        },
        "tasks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ProviderTaskSelection"
          },
          "maxItems": 100,
          "uniqueItems": true
        }
      },
      "required": [
        "contractVersion",
        "profile",
        "ownerSubject",
        "vaultId",
        "provider",
        "slotId",
        "retiredCredentials",
        "tasks"
      ],
      "additionalProperties": false
    },
    "ProviderLegacyCredential": {
      "type": "object",
      "properties": {
        "ownerSubject": {
          "$ref": "#/$defs/Identifier"
        },
        "vaultId": {
          "$ref": "#/$defs/Identifier"
        },
        "provider": {
          "enum": ["muse", "chatgpt"]
        },
        "reference": {
          "$ref": "#/$defs/ProviderCredentialRef"
        }
      },
      "required": ["ownerSubject", "vaultId", "provider", "reference"],
      "additionalProperties": false
    },
    "ProviderSlotApproval": {
      "type": "object",
      "properties": {
        "contractVersion": {
          "const": "folioview.agent-workspace.v2.0"
        },
        "profile": {
          "const": "folioview.provider-connection-slot.v1"
        },
        "ownerSubject": {
          "$ref": "#/$defs/Identifier"
        },
        "vaultId": {
          "$ref": "#/$defs/Identifier"
        },
        "provider": {
          "enum": ["muse", "chatgpt"]
        },
        "slotId": {
          "$ref": "#/$defs/Identifier"
        },
        "artifactType": {
          "const": "provider_connection_update"
        },
        "action": {
          "enum": ["activate", "disconnect"]
        },
        "rootKeyId": {
          "$ref": "#/$defs/KeyId"
        },
        "expectedSlotVersion": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "expectedSlotGeneration": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "previousCredentialFingerprint": {
          "anyOf": [
            {
              "$ref": "#/$defs/Digest"
            },
            {
              "type": "null"
            }
          ]
        },
        "candidateCredentialFingerprint": {
          "anyOf": [
            {
              "$ref": "#/$defs/Digest"
            },
            {
              "type": "null"
            }
          ]
        },
        "reviewDigest": {
          "anyOf": [
            {
              "$ref": "#/$defs/Digest"
            },
            {
              "type": "null"
            }
          ]
        },
        "setupIntentId": {
          "anyOf": [
            {
              "$ref": "#/$defs/OperationIdentifier"
            },
            {
              "type": "null"
            }
          ]
        },
        "deviceSigningKeyId": {
          "$ref": "#/$defs/KeyId"
        },
        "stableOperationId": {
          "$ref": "#/$defs/OperationIdentifier"
        },
        "registrySequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "checkpointDigest": {
          "$ref": "#/$defs/Digest"
        },
        "keyEpoch": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "issuedAt": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "contractVersion",
        "profile",
        "ownerSubject",
        "vaultId",
        "provider",
        "slotId",
        "artifactType",
        "action",
        "rootKeyId",
        "expectedSlotVersion",
        "expectedSlotGeneration",
        "previousCredentialFingerprint",
        "candidateCredentialFingerprint",
        "reviewDigest",
        "setupIntentId",
        "deviceSigningKeyId",
        "stableOperationId",
        "registrySequence",
        "checkpointDigest",
        "keyEpoch",
        "issuedAt"
      ],
      "additionalProperties": false
    },
    "ProviderSlotOperation": {
      "type": "object",
      "properties": {
        "contractVersion": {
          "const": "folioview.agent-workspace.v2.0"
        },
        "profile": {
          "const": "folioview.provider-connection-slot.v1"
        },
        "ownerSubject": {
          "$ref": "#/$defs/Identifier"
        },
        "vaultId": {
          "$ref": "#/$defs/Identifier"
        },
        "provider": {
          "enum": ["muse", "chatgpt"]
        },
        "slotId": {
          "$ref": "#/$defs/Identifier"
        },
        "stableOperationId": {
          "$ref": "#/$defs/OperationIdentifier"
        },
        "operationFingerprint": {
          "$ref": "#/$defs/Digest"
        },
        "slotVersion": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "slotGeneration": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "currentCredentialFingerprint": {
          "anyOf": [
            {
              "$ref": "#/$defs/Digest"
            },
            {
              "type": "null"
            }
          ]
        },
        "acceptedAt": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "contractVersion",
        "profile",
        "ownerSubject",
        "vaultId",
        "provider",
        "slotId",
        "stableOperationId",
        "operationFingerprint",
        "slotVersion",
        "slotGeneration",
        "currentCredentialFingerprint",
        "acceptedAt"
      ],
      "additionalProperties": false
    }
  }
}
