# Public Market service. User and Config have separate environment examples.
# Start with services/common on PYTHONPATH; see the root README.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Daily Yahoo prices, shared by anonymous visitors. Use mock only for fixtures.
MARKET_DATA_SOURCE=yfinance
# SQLite is local-only. Cloud Run requires firestore.
MARKET_CACHE_BACKEND=sqlite
MARKET_CACHE_PATH=/tmp/financial-analysis/market.sqlite3
MARKET_CACHE_TTL_SECONDS=3600
MARKET_UPSTREAM_DAILY_LIMIT=200
# Same existing database and market cache collections; no data migration.
GOOGLE_CLOUD_PROJECT=
MARKET_FIRESTORE_DATABASE=(default)
