# Copy into a local environment; these are public configuration values, not private keys.
# uvicorn app.main:app --reload --port 8000 --env-file .env
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
FIREBASE_PROJECT_ID=your-firebase-project-id

# Daily Yahoo prices, shared by anonymous visitors. Use mock only for fixtures.
MARKET_DATA_SOURCE=yfinance
# Local default. Cloud Run requires firestore; SQLite is refused on Cloud Run.
MARKET_CACHE_BACKEND=sqlite
MARKET_CACHE_PATH=/tmp/financial-analysis/market.sqlite3
# Watchlists reuse MARKET_CACHE_BACKEND and the same Firestore database on Cloud Run.
# Local SQLite watchlists survive API restarts; never point this file at a shared server.
WATCHLIST_DB_PATH=/tmp/financial-analysis/watchlists.sqlite3
MARKET_CACHE_TTL_SECONDS=3600
MARKET_UPSTREAM_DAILY_LIMIT=200
# Cloud Run: set MARKET_CACHE_BACKEND=firestore, create a Native Firestore
# database, and grant only the API runtime identity roles/datastore.user.
# The Admin SDK uses ADC. Browser Firestore access can remain entirely denied.
MARKET_FIRESTORE_DATABASE=(default)

# Optional LOCAL Auth emulator, using the same project ID as the frontend.
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# Never set the emulator host on Cloud Run. Production uses the attached service
# account through Application Default Credentials, without a downloaded JSON key.
