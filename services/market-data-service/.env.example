# Copy into a local environment; these are public configuration values, not private keys.
# uvicorn app.main:app --reload --port 8000 --env-file .env
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
FIREBASE_PROJECT_ID=your-firebase-project-id

# Optional LOCAL Auth emulator, using the same project ID as the frontend.
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# Never set the emulator host on Cloud Run. Production uses the attached service
# account through Application Default Credentials, without a downloaded JSON key.
