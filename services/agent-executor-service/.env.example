# Build-only target: actual Confidential Space provisioning belongs to INF-012.
EXECUTOR_ENABLED=0
EXECUTOR_CREATION_ENABLED=0
EXECUTOR_NATIVE_ENABLED=0
# Public reviewed configuration only; never a private key or native token.
EXECUTOR_CONFIG=/run/executor/public-config.json
# Native config's canonical SHA-256 must also match the Root-approved measured environment.
EXECUTOR_NATIVE_CONFIG=/run/executor/native-config.json
# EXECUTOR_NATIVE_CONFIG_SHA256=<reviewed canonical JSON SHA-256>
# Production public-object alternatives exclude corresponding local file variables.
# URI + Root key ID are pinned by the Root-approved workload environment.
# EXECUTOR_CONFIG_OBJECT=gs://reviewed-state-bucket/executor-config/runtime.json
# EXECUTOR_NATIVE_CONFIG_OBJECT=gs://reviewed-state-bucket/executor-config/native.json
# EXECUTOR_ROOT_KEY_ID=<independently reviewed public Root thumbprint>
# Explicit creation mode uses these public sources with runtime/native disabled:
# EXECUTOR_DRAFT_OBJECT=gs://reviewed-state-bucket/executor-config/draft.json
# EXECUTOR_PERMIT_OBJECT=gs://reviewed-state-bucket/executor-config/permit.json
# EXECUTOR_ROOT_JWK_OBJECT=gs://reviewed-state-bucket/executor-config/root.json
