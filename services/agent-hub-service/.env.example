# Empty explicitly disables browser origins. Unset uses shared localhost defaults.
CORS_ORIGINS=
PORT=8080
# Private routes use verified Firebase Google login. No credentials are needed for health.
FIREBASE_PROJECT_ID=
# Cloud Run requires firestore + an explicit named database; default DB/emulator are refused.
AGENT_HUB_STORE_BACKEND=sqlite
AGENT_HUB_DB_PATH=/tmp/folioview/agent-hub.sqlite3
FIRESTORE_DATABASE=
# Fixed HTTPS Hub origin and Portfolio workload identity; unconfigured delegation fails closed.
HUB_SERVICE_AUDIENCE=
HUB_PORTFOLIO_CALLER_EMAIL=
# JSON mapping Google service-account subject IDs to the same Portfolio email above.
HUB_TRUSTED_PORTFOLIO_CALLERS=
# An existing RSA PKCS1 SHA256 asymmetric KMS key VERSION; never a private JWK/PEM.
# This slice creates no key/IAM/service and does not enable deployment.
HUB_KMS_SIGNING_KEY_VERSION=
# Owner catalogue only: Hub runtime identity, distinct from the reverse Portfolio caller above.
HUB_CATALOGUE_CALLER_EMAIL=
# Fixed producer origins. Missing/invalid settings leave that producer unavailable.
HUB_USER_ORIGIN=
HUB_PORTFOLIO_ORIGIN=
# Native account bootstrap uses this existing Hub origin and preregistered providers.
# Local placeholders only; no private Agent JWK/PEM belongs in cloud configuration.
HUB_OAUTH_ENABLED=0
HUB_OAUTH_ISSUER=
# Exact same-issuer HTTPS account-consent page; no arbitrary callback URL.
HUB_OAUTH_CONSENT_URL=
HUB_OAUTH_CLIENTS_JSON=[]
# Personal Agent route: all new capabilities stay off until a reviewed deployment.
HUB_AGENT_OWNED_CREDENTIALS_ENABLED=0
HUB_PERSISTENT_TRANSPORT_ENABLED=0
HUB_PERSISTENT_MCP_ENABLED=0
HUB_PERSISTENT_RESOURCE_CONSENTS_ENABLED=0
HUB_PERSISTENT_PUBLICATIONS_ENABLED=0
HUB_PERSISTENT_EXECUTION_ENABLED=0
HUB_PERSISTENT_RESULTS_ENABLED=0
# Exact existing Web /agents URL; its origin must appear in CORS_ORIGINS.
HUB_AGENT_OWNER_URL=
# Compatible producer API only. Do not enable or migrate accounts as part of deployment.
HUB_PROVIDER_CONNECTION_SLOTS_ENABLED=0
