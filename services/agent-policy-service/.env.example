PORT=8080
# Exact owner UI origins; credentials are permitted only for this explicit list.
CORS_ORIGINS=
FIREBASE_PROJECT_ID=
# Independent domain and key-only attested recovery each default off.
POLICY_ENABLED=0
POLICY_KEY_RELEASE_ENABLED=0
# Closed public JSON; public JWKs, owner hash, preregistrations, KMS references and
# pinned witness/snapshot resources. See docs/protocol.md. No Root/private keys.
POLICY_CONFIG=
# Cloud Run requires cloud. SQLite is local fixture/development only.
POLICY_STORE_BACKEND=cloud
POLICY_LOCAL_WITNESS=/tmp/folioview-policy/live/authority.sqlite3
POLICY_LOCAL_SNAPSHOTS=/tmp/folioview-policy/snapshots
