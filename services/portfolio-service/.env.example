PORT=8080
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Required only for private routes; select your own Firebase project and local ADC.
FIREBASE_PROJECT_ID=
PORTFOLIO_STORE_BACKEND=sqlite
PORTFOLIO_DB_PATH=/tmp/folioview/portfolio.sqlite3
# Cloud Run must select firestore and an explicit isolated named database.
FIRESTORE_DATABASE=
# No HTTP or env-based root/authority enrollment. Trusted Hub public projection
# must exist before private storage is usable; health remains independent.
# Metadata-only source producer: optional explicit trust, closed by default.
# These settings do not install roots, enable agent ciphertext delivery or Hub ACKs.
PORTFOLIO_SERVICE_AUDIENCE=
PORTFOLIO_DELEGATION_AUDIENCE=
PORTFOLIO_DELEGATION_ISSUER=
PORTFOLIO_TRUSTED_HUB_CALLERS=

# Fixed HTTPS Hub origin for explicit owner-triggered public authority replication.
# Absent remains closed; requests still need Hub delegation + runtime workload identity.
PORTFOLIO_HUB_AUTHORITY_ORIGIN=
