{
  "name": "financial-analysis-platform",
  "author": "Xianxin Zeng",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.12.0"
  },
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "prepare": "simple-git-hooks",
    "dev:web": "npm run dev --workspace @financial-analysis/web",
    "build:web": "npm run build --workspace @financial-analysis/web",
    "start:web": "npm run start --workspace @financial-analysis/web",
    "typecheck:web": "npm run typecheck --workspace @financial-analysis/web",
    "lint:api": "services/market-data-service/.venv/bin/ruff check --config services/market-data-service/pyproject.toml services scripts",
    "lint:infra": "services/market-data-service/.venv/bin/ruff check --config services/market-data-service/pyproject.toml infra/gcp",
    "test:api": "services/market-data-service/.venv/bin/python scripts/test_services.py",
    "test:infra": "services/market-data-service/.venv/bin/python -m unittest discover -s infra/gcp/tests -v",
    "test:ci": "services/market-data-service/.venv/bin/python -m unittest discover -s scripts/ci/tests -v",
    "test:web": "node --test apps/web/tests/*.test.cjs",
    "format:web": "prettier --write .",
    "format:api": "services/market-data-service/.venv/bin/ruff format --config services/market-data-service/pyproject.toml services scripts",
    "format:infra": "services/market-data-service/.venv/bin/ruff format --config services/market-data-service/pyproject.toml infra/gcp",
    "format:check:web": "prettier --check .",
    "format:check:api": "services/market-data-service/.venv/bin/ruff format --check --config services/market-data-service/pyproject.toml services scripts",
    "format:check:infra": "services/market-data-service/.venv/bin/ruff format --check --config services/market-data-service/pyproject.toml infra/gcp",
    "lint": "npm run typecheck:web && npm run lint:api && npm run lint:infra",
    "format": "npm run format:web && npm run format:api && npm run format:infra",
    "format:check": "npm run format:check:web && npm run format:check:api && npm run format:check:infra",
    "check": "npm run security:scan && npm run lint && npm run test:web && npm run test:api && npm run test:infra && npm run test:ci && npm run format:check",
    "security:scan": "python3 scripts/ci/secret_scan.py check --directory .security-tools"
  },
  "simple-git-hooks": {
    "pre-commit": "npm run check"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "simple-git-hooks": "^2.14.0"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.13.6"
  }
}
