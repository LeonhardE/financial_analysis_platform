NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Independent account and preference services. Omit either value to keep that
# domain on NEXT_PUBLIC_API_BASE_URL while migrating an existing deployment.
NEXT_PUBLIC_USER_API_BASE_URL=http://localhost:8001
NEXT_PUBLIC_CONFIG_API_BASE_URL=http://localhost:8002

# Optional: set all four values from the Firebase Web app settings to enable Google sign-in.
# These values are public browser configuration, not service account credentials.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Development only. Never set this for a deployed service.
# NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_URL=http://127.0.0.1:9099

# These values are ONLY used by next dev on a loopback page with a
# loopback HTTP(S) API. It cannot enable a deployed browser's direct connection.
NEXT_PUBLIC_PORTFOLIO_API_BASE_URL=
NEXT_PUBLIC_AGENT_HUB_API_BASE_URL=

# Server runtime configuration, never NEXT_PUBLIC or Docker build arguments.
# Use the validated REPO-002 projection when activating a deployment separately.
# Disabled or malformed configuration keeps the affected owner module unavailable.
FOLIOVIEW_OWNER_FIREBASE_PROJECT_ID=
FOLIOVIEW_PORTFOLIO_OWNER_ENABLED=false
FOLIOVIEW_PORTFOLIO_ORIGIN=
FOLIOVIEW_PORTFOLIO_AUDIENCE=
# Independent public Hub owner forwarding; no workload-token audience is needed.
FOLIOVIEW_HUB_OWNER_ENABLED=false
FOLIOVIEW_HUB_ORIGIN=
