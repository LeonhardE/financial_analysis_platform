{
  "schema_version": 2,
  "terraform_version": "1.16.7",
  "max_plan_age_seconds": 21600,
  "targets": {
    "repo": {
      "directory": "infra/gcp/terraform/envs/prod/repo",
      "enabled": true,
      "configuration_controllers": [],
      "deployment_source": "trigger-v1"
    },
    "market": {
      "enabled": true,
      "directory": "infra/gcp/terraform/envs/prod/market",
      "configuration_controllers": ["module.market.terraform_data.configuration"],
      "deployment_source": "trigger-v1"
    },
    "user": {
      "enabled": true,
      "directory": "infra/gcp/terraform/envs/prod/user",
      "configuration_controllers": ["module.user.terraform_data.configuration"],
      "deployment_source": "trigger-v1"
    },
    "config": {
      "enabled": true,
      "directory": "infra/gcp/terraform/envs/prod/config",
      "configuration_controllers": ["module.config.terraform_data.configuration"],
      "deployment_source": "trigger-v1"
    },
    "web": {
      "enabled": true,
      "directory": "infra/gcp/terraform/envs/prod/web",
      "deployment_source": "trigger-v1",
      "configuration_controllers": ["module.web.terraform_data.configuration"]
    },
    "portfolio": {
      "enabled": false,
      "directory": "infra/gcp/terraform/envs/prod/portfolio",
      "configuration_controllers": ["module.portfolio.terraform_data.configuration"],
      "deployment_source": "trigger-v1"
    },
    "agent-hub": {
      "enabled": false,
      "directory": "infra/gcp/terraform/envs/prod/agent-hub",
      "configuration_controllers": ["module.agent_hub.terraform_data.configuration"],
      "deployment_source": "inactive-v1"
    }
  }
}
