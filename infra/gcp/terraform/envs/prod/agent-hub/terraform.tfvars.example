# Illustrative non-production inputs only, not an existing image or apply approval.
# Supply the reviewed current candidate digest and matching private instance profile.
deployment = {
  project_id          = "example-project-1234"
  region              = "europe-west3"
  artifact_repository = "example-images"
  runtime_account_id  = "example-hub-runtime"
  creation_image      = "europe-west3-docker.pkg.dev/example-project-1234/example-images/agent-hub-api@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
  web_origin          = "https://web.example.invalid"
  hub_origin          = "https://hub.example.invalid"
}

# Exact producer sources and the inventoried Portfolio numeric subject/email pair
# may be supplied after inventory. Missing values fail closed, never trust a name.
sources = {
  user_origin               = ""
  portfolio_origin          = ""
  portfolio_caller_email    = ""
  trusted_portfolio_callers = {}
}

connector = {
  oauth_enabled             = false
  encrypted_adapter_enabled = false
  muse_clients              = []
}

# No activation or deployment is implied by preparing these source inputs.
persistent_mode_enabled = false # retired browser choice
agent_owned_mode_enabled = false
agent_clients = [] # supply only actual preregistered Muse/ChatGPT callbacks in the release window
